# Copy to bridge.env (same folder, or ~/.climateking-bridge/bridge.env) and fill in.
# This file holds your password: keep it on the bridge machine only, never commit it.

# Your Supabase project (the same values the app uses: Project Settings -> API).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The ClimateKing account that owns the ACs (the one you log in with in the app).
CK_EMAIL=you@example.com
CK_PASSWORD=your-password

# Optional
# CK_BRIDGE_NAME=home-pc          # shown in the app; defaults to the computer's name
# CK_POLL_SECONDS=10              # how often each AC is read
# CK_OFFLINE_AFTER=3              # failed reads in a row before an AC shows as offline
# CK_COMMAND_TTL_SECONDS=120      # commands older than this are not run
# CK_DISCOVERY_MINUTES=10         # how often to look for new ACs (0 = never)
# CK_LOG_LEVEL=INFO
# CK_LOG_FILE=bridge.log         # also write the log to this file

# Optional: Tuya cloud, for Hyundai / Smart Life units (local keys + remote backup).
# From iot.tuya.com -> Cloud -> your project -> Overview. Region: in, eu, us, sg, cn.
# TUYA_REGION=in
# TUYA_API_KEY=
# TUYA_API_SECRET=
