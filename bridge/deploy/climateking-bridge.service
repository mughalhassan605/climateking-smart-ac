# systemd unit for Linux / Raspberry Pi. Install:
#   sudo cp deploy/climateking-bridge.service /etc/systemd/system/
#   sudo systemctl enable --now climateking-bridge
#   journalctl -u climateking-bridge -f        # logs
[Unit]
Description=ClimateKing Home Bridge
Wants=network-online.target
After=network-online.target

[Service]
# Change User and the paths to where you installed the bridge.
User=pi
WorkingDirectory=/home/pi/climateking-smart-ac/bridge
ExecStart=/home/pi/climateking-smart-ac/bridge/.venv/bin/climateking-bridge run
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
